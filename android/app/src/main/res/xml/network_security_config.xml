<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：默认禁止明文（HTTP），仅对确实需要明文的上游放行。

  背景：原 AndroidManifest 使用 `android:usesCleartextTraffic="true"`，
  对所有域名全局放开明文流量，任何 http 请求（含第三方 SDK、WebView）
  都可被中间人窃听/篡改。

  本应用只直连酷狗（内置 API），其中只有登录网关仍是 http：
    - http://login.user.kugou.com/v7/send_mobile_code  （发送验证码）
    - http://login.user.kugou.com/v5/login_by_token    （token 刷新）
  其余接口（gateway / userservice / openapi / trackercdn / lyrics 等）均为 https。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">kugou.com</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- lint 要求每个 <domain> 显式声明 includeSubdomains，IP 无子域。 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
